#include <winver.h>
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "OLS Renamer - names WinOLS projects from their header"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "OlsRenamer"
      VALUE "OriginalFilename", "OLS Renamer.exe"
      VALUE "ProductName", "OLS Renamer"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
